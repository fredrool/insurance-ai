{
  "name": "insurance-ai-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:lambdas": "node scripts/build-lambdas.mjs",
    "test": "vitest run",
    "test:gateway": "tsx clients/gateway-mcp-test.ts",
    "test:workflow": "tsx clients/run-claim-workflow.ts",
    "export:corpus": "node scripts/export-corpus-to-s3.mjs",
    "terraform:init": "terraform -chdir=terraform init",
